[Unit]
Description=Back up PuzArchive SQLite database and trusted member configuration
After=puzarchive.service

[Service]
Type=oneshot
User=puzarchive
Group=puzarchive
Environment=PUZARCHIVE_DB_PATH=/var/lib/puzarchive/puzarchive.sqlite
Environment=PUZARCHIVE_USERS_PATH=/var/lib/puzarchive/trusted-users.json
Environment=PUZARCHIVE_BACKUP_DIR=/var/backups/puzarchive
ExecStart=/opt/puzarchive/runtime/bin/node /opt/puzarchive/app/deploy/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/puzarchive
ReadOnlyPaths=/var/lib/puzarchive /opt/puzarchive/app
CapabilityBoundingSet=
LockPersonality=true
